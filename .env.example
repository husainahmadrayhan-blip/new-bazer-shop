PORT=3000
# Neon Dashboard -> Project -> Connect -> Pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ADMIN_USER=admin
# Use a long unique password; do not commit .env
ADMIN_PASSWORD=replace-with-a-long-random-password

# Set this to the public HTTPS domain after deployment for Facebook link previews
PUBLIC_BASE_URL=https://your-domain.example
